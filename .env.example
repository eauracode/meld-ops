# Supabase: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, never prefix with NEXT_PUBLIC_. Used to send team invites.
SUPABASE_SECRET_KEY=sb_secret_...

# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Email for temporary passwords (any SMTP provider). Gmail: smtp.gmail.com, port 465,
# your Gmail address, and an App Password (Google Account > Security > 2-Step Verification > App passwords).
# Leave blank to turn emailing off; admins then share passwords themselves.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Meld <you@example.com>

# Public URL of the app, used in invite and password reset emails (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nightly backup to Google Sheets (see README). Leave blank to turn it off.
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
BACKUP_SHEET_ID=
# Vercel Cron sends this as a Bearer token to /api/backup.
CRON_SECRET=
